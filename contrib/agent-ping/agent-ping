#!/bin/sh
# agent-ping claude|codex   hook mode: hook JSON on stdin; marks the tmux window when the agent waits on me
# agent-ping ask TEXT...    an agent asks for my attention (run from its shell)
# agent-ping restore        after a resurrect restore: resume each recorded agent in its pane
# Hook mode is silent on stdout (hooks may read it as context) and always exits 0.
map="${XDG_STATE_HOME:-$HOME/.local/state}/agent-ping/panes.tsv"

if [ "$1" = restore ]; then
	[ -f "$map" ] || exit 0
	while IFS="$(printf '\t')" read -r s w p agent id; do
		t="=$s:$w.$p"
		case $(tmux display -p -t "$t" '#{pane_current_command}' 2>/dev/null) in
		sh|bash|zsh|dash|fish) ;;
		*) continue ;;
		esac
		case $agent in
		claude) tmux send-keys -t "$t" "claude --resume $id" Enter ;;
		codex) tmux send-keys -t "$t" "codex resume $id" Enter ;;
		esac
	done <"$map"
	exit 0
fi

[ -n "$TMUX_PANE" ] || exit 0
exec >/dev/null 2>&1
pane=$TMUX_PANE
now=$(date +%s)

if [ "$1" = ask ]; then
	shift
	event=Ask ntype=- sid=- keepalive=false reason=-
	text=$(printf '%s' "$*" | tr '\t\n' '  ' | cut -c1-200)
	if [ -n "$CLAUDECODE" ]; then agent=claude; elif [ -n "$CODEX_THREAD_ID" ]; then agent=codex; else agent=agent; fi
else
	agent=$1
	# One jq call; the prompt itself never leaves jq (it may hold tabs and newlines). Text is last
	# and flattened, so read gives it the rest of the line.
	IFS="$(printf '\t')" read -r event ntype sid keepalive reason text <<EOF
$(jq -r 'def flat: gsub("[\t\n\r]+"; " ") | .[0:200];
  [.hook_event_name, (.notification_type // .tool_name // "-"), (.session_id // "-"),
  ((.prompt // "") | startswith("keepalive:")), (.reason // "-"),
  ((if .hook_event_name == "PreToolUse" then
      (.tool_input.questions // []) as $q | ($q[0].question // "")
        + (if ($q | length) > 1 then " (+\(($q | length) - 1) more)" else "" end)
    elif .hook_event_name == "Stop" then
      (.last_assistant_message // "") | split("\n") | map(select(test("\\S"))) | (.[0] // "")
    else .message // "" end) | flat | if . == "" then "-" else . end)] | @tsv')
EOF
fi
[ "$text" = - ] && text=

IFS="$(printf '\t')" read -r sess win pidx shown wname <<EOF
$(tmux display -p -t "$pane" '#{session_name}	#{window_index}	#{pane_index}	#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}	#{window_name}')
EOF

# D38: remember which conversation runs in this pane, for agent-ping restore.
if [ "$sid" != - ]; then
	tmux set -p -t "$pane" @agent_session "$agent:$sid"
	mkdir -p "${map%/*}"
	# shortcut: two hooks writing at the same instant can lose one row; the next event rewrites it.
	{
		[ -f "$map" ] && awk -F '\t' -v s="$sess" -v w="$win" -v p="$pidx" '!($1==s && $2==w && $3==p)' "$map"
		# Quitting Claude on purpose drops the row; a kill or reboot (reason "other") keeps it.
		# shortcut: Codex always sends reason "other", so any Codex SessionEnd drops the row; if Codex
		# runs it while the VM shuts down, that session won't resume. Revisit if Codex adds reasons.
		case $agent:$event:$reason in *:SessionEnd:prompt_input_exit|*:SessionEnd:logout|codex:SessionEnd:*) ;; *)
			printf '%s\t%s\t%s\t%s\t%s\n' "$sess" "$win" "$pidx" "$agent" "$sid" ;;
		esac
	} >"$map.$$" && mv "$map.$$" "$map"
fi

case $(tmux show -wqv -t "$pane" @agent_waiting) in *'|ask') asking=1 ;; *) asking= ;; esac
why='' banner='' took=''
case $event:$ntype in
PreToolUse:AskUserQuestion | Notification:elicitation_dialog | Ask:*) why=ask banner=1 ;;
Notification:permission_prompt | PermissionRequest:*) why=permission banner=1 ;;
Notification:idle_prompt) why=idle ;;
Stop:*)
	if [ -n "$(tmux show -pqv -t "$pane" @agent_keepalive)" ]; then
		tmux set -pu -t "$pane" @agent_keepalive
	else
		why='done'
		start=$(tmux show -pqv -t "$pane" @agent_turn_start)
		# D42: only a long turn sends a banner.
		[ -n "$start" ] && [ $((now - start)) -ge 120 ] && banner=1 took=$(((now - start) / 60))m
	fi
	;;
UserPromptSubmit:*)
	# A keepalive turn must not clear a real mark, nor leave one behind when it stops.
	if [ "$keepalive" = true ]; then
		tmux set -p -t "$pane" @agent_keepalive 1
	else
		tmux set -wu -t "$pane" @agent_waiting
		tmux set -wu -t "$pane" @agent_text
		tmux set -p -t "$pane" @agent_turn_start "$now"
	fi
	;;
SessionEnd:*) tmux set -wu -t "$pane" @agent_waiting \; set -wu -t "$pane" @agent_text ;;
esac

# I'm already looking at this pane: no mark, no banner.
[ "$shown" = 1 ] && why=
[ -n "$why" ] || banner=
# D43: an open ask outranks every other mark; only a prompt or SessionEnd clears it.
# D63: the text goes with the mark, for Raycast's Waiting Agents.
[ -n "$why" ] && { [ "$why" = ask ] || [ -z "$asking" ]; } &&
	tmux set -w -t "$pane" @agent_waiting "$now|$why" \; set -w -t "$pane" @agent_text "$text"
[ -n "$asking" ] && [ "$why" = permission ] && banner=

marks=$(tmux list-windows -a -F '#{@agent_waiting}')
tmux set -g @agents_asking "$(printf '%s\n' "$marks" | grep -c '|ask$')"
tmux set -g @agents_waiting "$(printf '%s\n' "$marks" | grep -c '|[^a]')"

[ -n "$banner" ] || exit 0
case $agent in claude) who=Claude ;; codex) who=Codex ;; *) who=Agent ;; esac
case $why in
ask) title="$who asks · $sess:$win" ;;
permission) title="$who needs permission · $sess:$win" ;;
*) title="$who done · $sess:$win · $took" ;;
esac
# D44: iTerm2 gets a payload for the agent_ping.py script (title, subtitle, body); others get OSC 9.
payload=$(jq -nc --arg t "$title" --arg s "$wname" --arg b "$text" --arg g "$sess:$win" '{title: $t, subtitle: $s, body: $b, group: $g}' | base64 | tr -d '\n')
tmux list-clients -F '#{client_tty}	#{client_termtype}' | while IFS="$(printf '\t')" read -r tty term; do
	case $term in
	iTerm2*) printf '\033]1337;Custom=id=agent-ping:%s\007' "$payload" >"$tty" ;;
	*) printf '\033]9;%s\007' "$title${text:+: $text}" >"$tty" ;;
	esac
	tmux display -c "$tty" -d 5000 -l "$([ "$why" = ask ] && echo '?' || echo '●') $title${text:+ — $text}"
done
# D52: while the flash shows, a click on the status line goes to this window. A later flash
# takes over; only the flash that set the option clears it.
tmux set -g @agent_flash_win "$(tmux display -p -t "$pane" '#{window_id}')"
tmux set -g @agent_flash_by "$$"
(sleep 5; [ "$(tmux show -gqv @agent_flash_by)" = "$$" ] && tmux set -gu @agent_flash_win) </dev/null >/dev/null 2>&1 &
exit 0
