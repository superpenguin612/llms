#!/usr/bin/env python3
"""delegate: run a cheap pi worker (OpenCode Go) on a brief, in its own git worktree and a sandbox.

  delegate run    --repo PATH --task NAME --brief FILE [--chain implementation|bulk] [--timeout 45m] [--here]
  delegate retry  TASK --feedback FILE
  delegate clean  TASK [--opus] [--force]
  delegate status [TASK]

The worker commits on `delegate/<task>` (or in place with --here) and writes `result.md` in its
run folder (~/.local/share/delegate/runs/<task>/). On a timeout or API error the next model in
the chain starts over from the base commit; the failed attempt's commits stay on
`delegate/<task>@<model>`. `retry` continues the last pi session once with written feedback. Every run is one line in ~/.local/share/delegate/runs.jsonl.
Python 3 stdlib only.
"""

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
DATA = Path.home() / ".local/share/delegate"
RUNS = DATA / "runs"
LOG = DATA / "runs.jsonl"
MAX_LIVE = 3
# The worker's environment starts empty plus these (if set), the Go key and DELEGATE_RUN.
ALLOW = ("PATH", "HOME", "USER", "LANG", "TERM", "SHELL", "TMPDIR")
# Credentials hidden from the worker, relative to ~. A new credential location must be added here.
HIDE = ("creds", ".ssh", ".claude/.credentials.json", ".codex/auth.json", ".config/gh", ".pi/agent/auth.json")


def die(msg):
    sys.exit(f"delegate: {msg}")


def git(cwd, *args):
    p = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    if p.returncode:
        die(f"git {' '.join(args)}: {p.stderr.strip()}")
    return p.stdout.strip()


def alive(marker):
    try:
        os.kill(int(marker.read_text()), 0)
        return True
    except (OSError, ValueError):
        return False


def records():
    return [json.loads(l) for l in LOG.read_text().splitlines() if l.strip()] if LOG.exists() else []


def save(rec):
    """Write the task's line in runs.jsonl: replace it if present, else append."""
    DATA.mkdir(parents=True, exist_ok=True)
    LOG.touch()
    with open(LOG, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines, found = [], False
        for line in f.read().splitlines():
            if line.strip() and json.loads(line)["task"] == rec["task"]:
                line, found = json.dumps(rec), True
            lines.append(line)
        if not found:
            lines.append(json.dumps(rec))
        f.seek(0)
        f.truncate()
        f.write("\n".join(lines) + "\n")


def go_key():
    f = Path.home() / "creds/opencode-go.env"
    for line in f.read_text().splitlines() if f.exists() else []:
        k, _, v = line.removeprefix("export ").partition("=")
        if k.strip() == "OPENCODE_API_KEY":
            return v.strip().strip("'\"")
    die(f"no OPENCODE_API_KEY in {f}")


def sandbox(workdir, run, key, argv):
    """argv under bubblewrap: empty environment plus ALLOW, credentials in HIDE hidden
    (dirs as empty tmpfs, files as an empty read-only file), own PID namespace so a timeout
    kills everything the worker started."""
    env = [f"{k}={os.environ[k]}" for k in ALLOW if k in os.environ]
    env += [f"OPENCODE_API_KEY={key}", f"DELEGATE_RUN={run}",
            # The signing key (~/creds/git_signing) is hidden, so commits can't be SSH-signed: worker commits are unsigned.
            "GIT_CONFIG_COUNT=1", "GIT_CONFIG_KEY_0=commit.gpgsign", "GIT_CONFIG_VALUE_0=false"]
    empty = DATA / "empty"
    if not empty.exists():
        DATA.mkdir(parents=True, exist_ok=True)
        empty.touch(0o444)
    hide = []
    for rel in HIDE:
        p = Path.home() / rel
        if p.is_dir():
            hide += ["--tmpfs", str(p)]
        elif p.exists():
            hide += ["--ro-bind", str(empty), str(p)]
    bwrap = shutil.which("bwrap") or die("bwrap not found (apt install bubblewrap)")
    return ["env", "-i", *env, bwrap, "--dev-bind", "/", "/", "--proc", "/proc", *hide,
            "--unshare-pid", "--die-with-parent", "--chdir", str(workdir), "--", *argv]


def usage(session, skip=0):
    """Token and cost sums of the assistant messages in a pi session log (after `skip` lines),
    and the last message's stopReason."""
    tot = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "cost": 0.0}
    stop = None
    for line in Path(session).read_text().splitlines()[skip:] if session else []:
        m = json.loads(line).get("message") or {}
        if m.get("role") != "assistant":
            continue
        u = m.get("usage") or {}
        tot["input"] += u.get("input", 0)
        tot["output"] += u.get("output", 0)
        tot["cache_read"] += u.get("cacheRead", 0)
        tot["cache_write"] += u.get("cacheWrite", 0)
        tot["cost"] += (u.get("cost") or {}).get("total", 0)
        stop = m.get("stopReason")
    return tot, stop


def claim(run):
    """Mark the run live, refusing a 4th concurrent run."""
    live = [m for m in RUNS.glob("*/running") if alive(m)]
    if len(live) >= MAX_LIVE:
        die(f"{MAX_LIVE} runs are already live ({', '.join(m.parent.name for m in live)}); wait for one")
    (run / "running").write_text(str(os.getpid()))


def attempt(rec, model, message, key, session=None):
    """One pi run in the sandbox; with `session`, continue that pi session instead of starting one."""
    run = Path(rec["run"])
    workdir = rec["worktree"] or rec["repo"]
    sessions = run / "sessions"
    before = set(sessions.glob("*.jsonl"))
    skip = len(Path(session).read_text().splitlines()) if session else 0
    pi = shutil.which("pi") or die("pi not found on PATH")
    argv = [pi, "--provider", "opencode-go", "--model", model, "-p",
            *(["--session", session] if session else ["--session-dir", str(sessions)]),
            "--append-system-prompt", str(HERE / "worker-rules.md"), "--", message]
    start = time.time()
    with open(run / "pi.log", "a") as log:
        log.write(f"=== {model} {time.strftime('%Y-%m-%dT%H:%M:%S')}\n")
        log.flush()
        rc = subprocess.run(["timeout", "--kill-after=30", rec["timeout"], *sandbox(workdir, run, key, argv)],
                            stdout=log, stderr=subprocess.STDOUT).returncode
    if not session:
        new = sorted(set(sessions.glob("*.jsonl")) - before)
        session = str(new[-1]) if new else None
    tot, stop = usage(session, skip)
    if rc in (124, 137):  # 137: still running after --kill-after
        outcome = "timeout"
    elif rc == 0 and (run / "result.md").exists():
        outcome = "ok"
    elif rc and stop == "error":  # pi logs a failed API call as stopReason "error" and exits 1
        outcome = "api_error"
    else:
        outcome = "failed"
    return {"model": model, "outcome": outcome, "exit": rc, **tot,
            "seconds": round(time.time() - start), "session": session}


def summary(rec):
    run = Path(rec["run"])
    att = rec["attempts"][-1] if rec["attempts"] else {}
    print(f"delegate: {rec['task']} {rec['status']} ({att.get('model')})")
    if rec["worktree"]:
        commits = git(rec["worktree"], "log", "--oneline", f"{rec['base_commit']}..HEAD")
        print("commits:\n" + ("\n".join("  " + c for c in commits.splitlines()) or "  none"))
    result = run / "result.md"
    if result.exists():
        print("result.md:\n" + "\n".join("  " + l for l in result.read_text().splitlines()[:15]))
    print(f"run: {run}")
    if rec["worktree"]:
        print(f"worktree: {rec['worktree']} (branch {rec['branch']})")


def cmd_run(a):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", a.task):
        die("task names use letters, digits, '.', '_' and '-'")
    chain = json.loads((HERE / "chains.json").read_text()).get(a.chain)
    if not chain:
        die(f"chain '{a.chain}' is empty or missing in {HERE / 'chains.json'}")
    run = RUNS / a.task
    if run.exists():
        die(f"task {a.task} exists ({run}); pick another name")
    brief = Path(a.brief).read_text()
    key = go_key()
    rec = {"task": a.task, "mode": "here" if a.here else "worktree", "chain": a.chain, "timeout": a.timeout,
           "run": str(run), "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
           "attempts": [], "status": "running", "outcome": None}
    if a.here:  # in place, e.g. a vault: no worktree, no branch, not necessarily a git repo
        rec |= {"repo": str(Path(a.repo).resolve()), "base_branch": None, "base_commit": None,
                "branch": None, "worktree": None}
    else:
        repo = Path(git(a.repo, "rev-parse", "--show-toplevel"))
        wt = DATA / "worktrees" / repo.name / a.task
        rec |= {"repo": str(repo), "base_branch": git(repo, "rev-parse", "--abbrev-ref", "HEAD"),
                "base_commit": git(repo, "rev-parse", "HEAD"), "branch": f"delegate/{a.task}",
                "worktree": str(wt)}
    run.mkdir(parents=True)  # claims the task name
    try:
        claim(run)
    except SystemExit:
        shutil.rmtree(run)
        raise
    try:
        if wt := rec["worktree"]:
            git(rec["repo"], "worktree", "add", "-q", "-b", rec["branch"], wt, "HEAD")
        (run / "sessions").mkdir()
        (run / "brief.md").write_text(brief)
        save(rec)
        for i, model in enumerate(chain):
            att = attempt(rec, model, brief, key)
            rec["attempts"].append(att)
            rec["status"] = att["outcome"]
            save(rec)
            if att["outcome"] not in ("timeout", "api_error") or i == len(chain) - 1:
                break
            # Infrastructure failure: start the next model over; in a worktree, keep the attempt's
            # commits on a backup branch and reset to the base.
            (run / "result.md").unlink(missing_ok=True)
            if not wt:
                continue
            if git(wt, "rev-parse", "HEAD") != rec["base_commit"]:
                git(wt, "branch", "-f", f"{rec['branch']}@{model}", "HEAD")
            git(wt, "reset", "-q", "--hard", rec["base_commit"])
            git(wt, "clean", "-qfd")
    finally:
        (run / "running").unlink()
    summary(rec)
    return 0 if rec["status"] == "ok" else 1


def find(task):
    return next((r for r in records() if r["task"] == task), None) or die(f"no run named {task}")


def cmd_retry(a):
    rec = find(a.task)
    run = Path(rec["run"])
    if rec["outcome"]:
        die(f"{a.task} is already cleaned ({rec['outcome']})")
    if alive(run / "running"):
        die(f"{a.task} is still running")
    if any(x.get("retry") for x in rec["attempts"]):
        die(f"{a.task} was already retried once; take it over instead")
    last = rec["attempts"][-1] if rec["attempts"] else {}
    if not last.get("session"):
        die(f"{a.task} has no pi session to continue")
    feedback = Path(a.feedback).read_text()
    key = go_key()
    claim(run)
    try:
        (run / "feedback.md").write_text(feedback)
        (run / "result.md").unlink(missing_ok=True)
        att = attempt(rec, last["model"], feedback, key, session=last["session"])
        rec["attempts"].append(att | {"retry": True})
        rec["status"] = att["outcome"]
        save(rec)
    finally:
        (run / "running").unlink()
    summary(rec)
    return 0 if rec["status"] == "ok" else 1


def cmd_clean(a):
    rec = find(a.task)
    if rec["outcome"]:
        die(f"{a.task} is already cleaned ({rec['outcome']})")
    if alive(Path(rec["run"]) / "running"):
        die(f"{a.task} is still running")
    repo, branch = rec["repo"], rec["branch"]
    if rec["worktree"]:
        head = subprocess.run(["git", "-C", repo, "rev-parse", "-q", "--verify", branch],
                              capture_output=True, text=True).stdout.strip()
        merged = head and head != rec["base_commit"] and subprocess.run(
            ["git", "-C", repo, "merge-base", "--is-ancestor", head, rec["base_branch"]]).returncode == 0
    else:
        merged = not a.force  # --here: accepted work is already in place
    if a.opus:
        outcome = "opus"
    elif merged:
        outcome = "merged"
    elif a.force:
        outcome = "abandoned"
    else:
        die(f"{branch} is not merged into {rec['base_branch']}; pass --force to abandon it, "
            "or --opus if Opus took over")
    if rec["worktree"]:
        if Path(rec["worktree"]).exists():
            git(repo, "worktree", "remove", "--force", rec["worktree"])
        git(repo, "worktree", "prune")
        for b in git(repo, "for-each-ref", "--format=%(refname:short)",
                     f"refs/heads/{branch}", f"refs/heads/{branch}@*").split():
            git(repo, "branch", "-q", "-D", b)
    rec["outcome"] = outcome
    save(rec)
    print(f"delegate: {a.task} cleaned ({outcome}); run folder kept: {rec['run']}")
    return 0


def cmd_status(a):
    if a.task:
        print(json.dumps(find(a.task), indent=2))
        return 0
    for r in records():
        if r["outcome"] is None:
            state = "running" if alive(Path(r["run"]) / "running") else r["status"]
            model = r["attempts"][-1]["model"] if r["attempts"] else "-"
            print(f"{r['task']}  {state}  {model}  {r['mode']}  {r['repo']}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="delegate", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("run", help="run a worker on a brief")
    p.add_argument("--repo", default=".")
    p.add_argument("--task", required=True)
    p.add_argument("--brief", required=True)
    p.add_argument("--chain", default="implementation")
    p.add_argument("--timeout", default="45m", type=lambda s: re.fullmatch(r"\d+[smh]?", s) and s
                   or die("--timeout takes e.g. 90s, 45m or 1h"))
    p.add_argument("--here", action="store_true", help="work in place (--repo or the current directory)")
    p.set_defaults(fn=cmd_run)
    p = sub.add_parser("retry", help="continue the last attempt's session once, with feedback")
    p.add_argument("task")
    p.add_argument("--feedback", required=True)
    p.set_defaults(fn=cmd_retry)
    p = sub.add_parser("clean", help="remove a task's worktree and branches and record its outcome")
    p.add_argument("task")
    p.add_argument("--opus", action="store_true", help="Opus took the task over")
    p.add_argument("--force", action="store_true", help="abandon an unmerged branch")
    p.set_defaults(fn=cmd_clean)
    p = sub.add_parser("status", help="list live and uncleaned runs, or show one")
    p.add_argument("task", nargs="?")
    p.set_defaults(fn=cmd_status)
    a = ap.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
