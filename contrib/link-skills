#!/bin/sh
# Link kb's skills and the vendored skills (git submodules in vendor/) into each agent's skills folder.
# Re-run after `git submodule update`.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
link() { mkdir -p "$1"; ln -sfn "$2" "$1/$(basename "$2")"; }
matt="$here/vendor/mattpocock-skills/skills"
skills="$here/skills/knowledge-base $here/skills/design-walkthrough
  $here/vendor/humanizer $here/skills/grilling $matt/engineering/tdd $matt/engineering/diagnosing-bugs"

for s in $skills; do link "$HOME/.codex/skills" "$s"; link "$HOME/.claude/skills" "$s"; done
for s in "$here"/vendor/ponytail/skills/*; do
  [ -f "$s/SKILL.md" ] && link "$HOME/.codex/skills" "$s" && link "$HOME/.claude/skills" "$s"
done

# Drop links to skills this repo no longer ships.
for d in "$HOME/.codex/skills" "$HOME/.claude/skills"; do
  for p in "$d"/*; do
    [ -L "$p" ] || continue
    case $(readlink "$p") in
      "$here"/*) [ -e "$p" ] || rm -f "$p" ;;
    esac
  done
done
