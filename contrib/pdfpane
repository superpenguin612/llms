#!/usr/bin/env python3
"""pdfpane FILE [PAGE]: show a PDF page or an image in a tmux side pane, drawn by timg as sixel.

Running it again reuses the pane. The pane redraws when the file changes or the pane is resized.
Keys in the pane:
  n space ] → next page      p [ ←   previous page     g G   first, last page
  :           go to page         + =     zoom in            -     zoom out
  0           fit page           w       fit width
  h j k l     pan (↑ ↓ too)      H J K L pan a full screen
  < >         widen, narrow pane f       full screen on/off
  r           redraw             q       close
"""

import os
import re
import select
import shutil
import shlex
import signal
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty

PAN_STEP = 0.25  # fraction of the view one h/j/k/l moves
ZOOM_STEP = 1.25


def log(msg):
    if os.environ.get("PDFPANE_DEBUG"):
        with open(os.environ["PDFPANE_DEBUG"], "a") as f:
            f.write(f"{time.monotonic():.3f} {msg}\n")


def die(msg):
    print(f"pdfpane: {msg}", file=sys.stderr)
    sys.exit(1)


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, check=True).stdout.strip()


def launch(path, page):
    if not os.environ.get("TMUX"):
        die("not inside tmux")
    here = os.environ.get("TMUX_PANE") or tmux("display", "-p", "#{pane_id}")
    cmd = shlex.join([os.path.realpath(sys.argv[0]), "--view", path, str(page)])
    panes = tmux("list-panes", "-t", here, "-F", "#{pane_id} #{@pdfpane}").splitlines()
    pane = next((p.split()[0] for p in panes if p.endswith(" 1")), None)
    if pane:
        tmux("respawn-pane", "-k", "-t", pane, cmd)
    else:
        pane = tmux("split-window", "-h", "-d", "-l", "45%", "-t", here, "-P", "-F", "#{pane_id}", cmd)
        tmux("set", "-p", "-t", pane, "@pdfpane", "1")
    print(f"pdfpane: {path} page {page} in pane {pane}")


class Viewer:
    def __init__(self, path, page):
        self.path, self.page = path, page
        self.is_pdf = path.lower().endswith(".pdf")
        self.zoom, self.fit = 1.0, "page"  # zoom is relative to the fit
        self.x = self.y = 0.0  # top-left of the view, as a fraction of the rendered page
        self.mtime = None
        self.tmp = tempfile.mkdtemp(prefix="pdfpane-")
        self.cache, self.sizes, self.lock = {}, {}, threading.Lock()
        self.total = 1

    # page facts
    def pages(self):
        if not self.is_pdf:
            return 1
        out = subprocess.run(["pdfinfo", self.path], capture_output=True, text=True).stdout
        m = re.search(r"^Pages:\s+(\d+)", out, re.M)
        return int(m.group(1)) if m else 1

    def page_size(self, page=None):
        """Page size in points (PDF) or pixels (image)."""
        page = page or self.page
        if (page, self.mtime) in self.sizes:
            return self.sizes[page, self.mtime]
        if self.is_pdf:
            out = subprocess.run(["pdfinfo", "-f", str(page), "-l", str(page), self.path],
                                 capture_output=True, text=True).stdout
            m = re.search(r"size:\s+([\d.]+) x ([\d.]+) pts", out)
            size = (float(m.group(1)), float(m.group(2))) if m else (612.0, 792.0)
        else:
            from PIL import Image
            with Image.open(self.path) as im:
                size = im.size
        self.sizes[page, self.mtime] = size
        return size

    def view_px(self):
        """The pane's drawing area in pixels, leaving one row for the status line."""
        cols, rows = os.get_terminal_size()
        try:
            cw, ch = (int(v) for v in tmux("display", "-p", "-t", os.environ["TMUX_PANE"],
                                            "#{client_cell_width} #{client_cell_height}").split())
        except Exception:
            cw, ch = 8, 16
        return cols, rows - 1, cols * cw, (rows - 1) * ch

    # drawing
    def geometry(self, page, x, y):
        """Everything one view depends on: the cache key and the crop to render."""
        cols, rows, vw, vh = self.view_px()
        pw, ph = self.page_size(page)
        fit = vw / pw if self.fit == "width" else min(vw / pw, vh / ph)
        scale = fit * self.zoom  # output pixels per page unit
        full_w, full_h = pw * scale, ph * scale
        x = min(max(x, 0.0), max(0.0, 1 - vw / full_w))
        y = min(max(y, 0.0), max(0.0, 1 - vh / full_h))
        crop = (int(x * full_w), int(y * full_h), int(min(vw, full_w)), int(min(vh, full_h)))
        key = (page, round(scale, 4), crop, cols, rows, self.mtime)
        return key, x, y, scale, (full_w, full_h), crop, cols, rows

    def build(self, page, scale, full, crop, cols, rows):
        """Render one view and return the bytes to write to the terminal."""
        cx, cy, cw, ch = crop
        base = os.path.join(self.tmp, f"{page}-{scale:.4f}-{cx}-{cy}-{cw}-{ch}-{threading.get_ident()}")
        if self.is_pdf:
            subprocess.run(["pdftoppm", "-f", str(page), "-l", str(page), "-r", f"{72 * scale:.2f}",
                            "-x", str(cx), "-y", str(cy), "-W", str(cw), "-H", str(ch),
                            "-singlefile", self.path, base], check=True, capture_output=True)
            image = base + ".ppm"
        else:
            from PIL import Image
            image = base + ".ppm"
            with Image.open(self.path) as im:
                im.convert("RGB").resize((int(full[0]), int(full[1]))).crop(
                    (cx, cy, cx + cw, cy + ch)).save(image)
        try:
            return subprocess.run(["timg", "-ps", f"-g{cols}x{rows}", image],
                                  capture_output=True, check=True).stdout
        finally:
            os.remove(image)

    def view(self, page, x, y):
        """The bytes for one view, from the cache or freshly built."""
        key, x, y, scale, full, crop, cols, rows = self.geometry(page, x, y)
        with self.lock:
            hit = self.cache.get(key)
        if hit is None:
            hit = self.build(page, scale, full, crop, cols, rows)
            with self.lock:
                self.cache[key] = hit
                while len(self.cache) > 12:
                    self.cache.pop(next(iter(self.cache)))
        return hit, x, y, rows, cols

    def prefetch(self):
        """Build the next and previous pages at the current zoom while the user reads this one."""
        for page in (self.page + 1, self.page - 1):
            if 1 <= page <= self.total:
                try:
                    self.view(page, self.x, 0.0)
                except Exception:
                    pass

    def render(self):
        t0 = time.monotonic()
        data, self.x, self.y, rows, cols = self.view(self.page, self.x, self.y)
        log(f"page {self.page} view {time.monotonic() - t0:.3f}s {len(data)} bytes")
        out = sys.stdout.buffer
        out.write(b"\x1b[2J\x1b[H" + data)
        fit = "fit width" if self.fit == "width" else "fit page"
        status = (f"{os.path.basename(self.path)}  {self.page}/{self.total}  {fit} {self.zoom * 100:.0f}%"
                  f"  [n/p +/- 0 w hjkl : <> f q]")
        out.write(f"\x1b[{rows + 1};1H\x1b[2K{status[:cols - 1]}".encode())
        out.flush()
        log(f"page {self.page} written {time.monotonic() - t0:.3f}s")
        threading.Thread(target=self.prefetch, daemon=True).start()

    def draw(self):
        try:
            self.mtime = os.stat(self.path).st_mtime
        except FileNotFoundError:
            self.mtime = None
            sys.stdout.write(f"\x1b[2J\x1b[Hwaiting for {self.path}")
            sys.stdout.flush()
            return
        self.total = self.pages()
        self.page = min(max(self.page, 1), self.total)
        try:
            self.render()
        except Exception as exc:
            sys.stdout.write(f"\x1b[2J\x1b[Hcannot draw {self.path}: {exc}")
            sys.stdout.flush()

    # input
    def read_key(self, timeout):
        if not select.select([sys.stdin], [], [], timeout)[0]:
            return None
        key = os.read(sys.stdin.fileno(), 1).decode(errors="ignore")
        if key == "\x1b" and select.select([sys.stdin], [], [], 0.02)[0]:
            seq = os.read(sys.stdin.fileno(), 8).decode(errors="ignore")
            return {"[A": "k", "[B": "j", "[C": "n", "[D": "p", "[5~": "p", "[6~": "n"}.get(seq)
        return key

    def goto_prompt(self):
        cols, rows, _, _ = self.view_px()
        sys.stdout.write(f"\x1b[{rows + 1};1H\x1b[2Kpage: ")
        sys.stdout.flush()
        digits = ""
        while (k := self.read_key(None)) not in ("\r", "\n", "\x1b", None):
            if k.isdigit():
                digits += k
                sys.stdout.write(k)
                sys.stdout.flush()
            elif k == "\x7f" and digits:
                digits = digits[:-1]
                sys.stdout.write("\b \b")
                sys.stdout.flush()
        if digits:
            self.page, self.x, self.y = int(digits), 0.0, 0.0

    def handle(self, k):
        _, _, vw, vh = self.view_px()
        if k in ("n", " ", "]"):
            if self.page < self.total:
                self.page, self.y = self.page + 1, 0.0
        elif k in ("p", "["):
            if self.page > 1:
                self.page, self.y = self.page - 1, 0.0
        elif k == "g":
            self.page, self.y = 1, 0.0
        elif k == "G":
            self.page, self.y = self.total, 0.0
        elif k == ":":
            self.goto_prompt()
        elif k in ("+", "="):
            self.zoom *= ZOOM_STEP
        elif k == "-":
            self.zoom = max(0.2, self.zoom / ZOOM_STEP)
        elif k == "0":
            self.fit, self.zoom, self.x, self.y = "page", 1.0, 0.0, 0.0
        elif k == "w":
            self.fit, self.zoom, self.x = "width", 1.0, 0.0
        elif k in "hjklHJKL" and len(k) == 1:
            step = 1.0 if k.isupper() else PAN_STEP
            # one step is a fraction of the view, expressed as a fraction of the page
            pw, ph = self.page_size()
            fit = vw / pw if self.fit == "width" else min(vw / pw, vh / ph)
            fw, fh = pw * fit * self.zoom, ph * fit * self.zoom
            dx, dy = step * vw / fw, step * vh / fh
            self.x += {"h": -dx, "l": dx}.get(k.lower(), 0)
            self.y += {"k": -dy, "j": dy}.get(k.lower(), 0)
        elif k in ("<", ">"):
            # widen or narrow this pane; the resize triggers a redraw through SIGWINCH
            pane = os.environ["TMUX_PANE"]
            width = int(tmux("display", "-p", "-t", pane, "#{pane_width}"))
            tmux("resize-pane", "-t", pane, "-x", str(width + (10 if k == "<" else -10)))
            return False
        elif k == "f":
            tmux("resize-pane", "-Z", "-t", os.environ["TMUX_PANE"])
            return False
        elif k == "q":
            sys.exit(0)
        elif k != "r":
            return False
        return True

    def run(self):
        redraw = [True]
        signal.signal(signal.SIGWINCH, lambda *_: redraw.__setitem__(0, True))
        old = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin)
        sys.stdout.write("\x1b[?25l")  # hide the cursor
        try:
            while True:
                try:
                    mtime = os.stat(self.path).st_mtime
                except FileNotFoundError:
                    mtime = None
                if mtime != self.mtime:
                    time.sleep(0.5)  # let a build finish writing before reading it
                    redraw[0] = True
                if redraw[0]:
                    redraw[0] = False
                    self.draw()
                try:
                    k = self.read_key(1.0)
                except InterruptedError:
                    continue
                if k:
                    log(f"key {k!r}")
                if k and self.handle(k):
                    redraw[0] = True
        finally:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
            sys.stdout.write("\x1b[?25h")
            shutil.rmtree(self.tmp, ignore_errors=True)


def main():
    args = sys.argv[1:]
    if args[:1] == ["--view"]:
        Viewer(args[1], int(args[2])).run()
        return
    if not 1 <= len(args) <= 2:
        die("usage: pdfpane FILE [PAGE]")
    if len(args) == 2 and not args[1].isdigit():
        die("PAGE must be a number")
    launch(os.path.realpath(args[0]), int(args[1]) if len(args) == 2 else 1)


if __name__ == "__main__":
    main()
